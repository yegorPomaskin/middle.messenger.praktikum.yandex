<div class="{{styles.formField}}">
  <label class="{{styles.label}}">{{label}}</label>
  <input type="{{type}}" name="{{name}}" class="{{styles.input}} {{#if errorText}}{{styles.inputError}}{{/if}}" value="{{value}}" {{#if required}}required{{/if}}>
  {{#if errorText}}
    <div class="{{styles.errorText}}">{{errorText}}</div>
  {{/if}}
</div>