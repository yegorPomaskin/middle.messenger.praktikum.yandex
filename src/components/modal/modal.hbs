{{#if isOpen}}
<div class="{{styles.modalOverlay}}" id="modalOverlay" style="display: block;">
    <div class="{{styles.modal}}" id="modalWindow" style="display: flex;">
        <h2 class="{{styles.modalTitle}}">{{title}}</h2>
        {{#if contentBlock}}
            {{{contentBlock}}}
        {{/if}}
    </div>
</div>
{{else}}
<div class="{{styles.modalOverlay}}" id="modalOverlay" style="display: none;">
    <div class="{{styles.modal}}" id="modalWindow" style="display: none;">
        <h2 class="{{styles.modalTitle}}">{{title}}</h2>
        {{#if contentBlock}}
            {{{contentBlock}}}
        {{/if}}
    </div>
</div>
{{/if}}