<div class="{{styles.chat__interface}}">
  <!-- Основная область для сообщений -->
  <div class="{{styles.chat__messages}}">
    {{#each messages}}
      <div class="{{styles.chat__message}}">
        <div class="{{styles.chat__message-info}}">
          <span class="{{styles.chat__message-user}}">{{userName}}</span>
          <span class="{{styles.chat__message-time}}">{{time}}</span>
        </div>
        <div class="{{styles.chat__message-text}}">
          {{text}}
        </div>
      </div>
    {{/each}}
  </div>

  <form class="{{styles.chat__interface-area}}">
    <img src="{{attachment}}" alt="Прикрепить" class="{{styles.chat__attachment-icon}}" />
    <input
      type="text"
      name="message"
      class="{{styles.chat__interface-input}}"
      placeholder="Напишите сообщение..."
    />
    <button type="submit" class="{{styles.chat__interface-sendButton}}">
      <img src="{{sendButton}}" alt="Отправить" class="{{styles.chat__interface-sendIcon}}" />
    </button>
  </form>
</div>